# ─────────────────────────────────────────────────────────────
# AI-Based Medical Report Analyzer — Backend Environment File
# Copy this file to .env and fill in your real values.
# DO NOT commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Python/Motor
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=medical_report_analyzer
# Keep true for a zero-setup local demo. Set false when using MongoDB Atlas.
USE_IN_MEMORY_DB=true

# ── JWT Authentication ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI Inference Provider ─────────────────────────────────────────────────
# AI_MODE options:
#   hf_space = Hugging Face ZeroGPU Space serving Qwen2.5-3B-Instruct (Recommended)
#   gemini   = Google Gemini API (requires GEMINI_API_KEY below)
#   ollama   = Local Ollama LLM server
#   offline  = Conservative local extraction without LLM
AI_MODE=hf_space

# ── Hugging Face Space (Qwen2.5-3B-Instruct) ──────────────────────────────
# Public Space — leave HF_TOKEN empty. Never put a token in frontend env.
# First request may be slow (ZeroGPU cold start, ~90s GPU budget).
HF_SPACE_URL=https://huggingface.co/spaces/adityaksingh/MediBridge-qwen
HF_TOKEN=
HF_TIMEOUT_SECONDS=120

# ── Google Gemini (optional; only needed when AI_MODE=gemini) ────────────
# Get a key: https://aistudio.google.com/apikey (keep it in backend .env only)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120

# ── LLM Summary Control ───────────────────────────────────────────────────
# false = never call any LLM (HF/Gemini/Ollama); deterministic local analysis
# with a template summary. Provider settings below stay intact for later use.
ENABLE_LLM_SUMMARY=true

# ── Ollama Local AI (explicit alternative only; not a silent fallback) ────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
