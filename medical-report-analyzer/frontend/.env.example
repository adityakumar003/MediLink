# Frontend environment example. Copy to .env.local only if needed.
#
# When empty, API calls use the current origin and Vite's dev proxy.
# For a separately deployed backend, set the full API origin (no trailing slash):
# VITE_API_URL=https://your-backend.example.com
#
# LiveKit credentials must NEVER be placed in frontend environment variables.
# The backend returns only the LiveKit server URL and a participant-scoped token.
VITE_API_URL=
